{
  "kind": "blacknode.workflow",
  "schema_version": 1,
  "name": "SO-ARM101 PPO Cloud Demo",
  "entrypoint": {"node_id": "out", "port": "value"},
  "metadata": {
    "template": true,
    "description": "Train, evaluate, export, and qualify a portable SO-ARM101 PPO policy on replicated Newton and Warp environments.",
    "color": "#76b900",
    "required_packages": ["blacknode-newton", "blacknode-training"],
    "required_components": ["blacknode-newton/runtime", "blacknode-training/reinforcement-learning"],
    "cloud": {"gpu_class": "l40s", "artifact_outputs": ["checkpoints", "evaluation.json", "policy.pt", "qualification.json"]},
    "safety": {"simulation_only": true, "physical_motion_authorized": false}
  },
  "node_meta": {
    "task": {
      "id": "task", "type": "SO101ReachTask", "pos": [80, 180],
      "params": {"asset_path": "package://blacknode-newton/assets/so101_robot.usd", "environment_count": 1024, "episode_steps": 128, "simulation_hz": 120, "control_hz": 30, "action_scale_deg": 3.0, "success_tolerance_m": 0.025, "seed": 42},
      "inputs": ["trigger", "asset_path", "environment_count", "episode_steps", "simulation_hz", "control_hz", "action_scale_deg", "success_tolerance_m", "seed"],
      "outputs": ["environment", "joint_names", "observation_dim", "action_dim", "report"],
      "input_types": {"trigger": "Any", "asset_path": "Text", "environment_count": "Int", "episode_steps": "Int", "simulation_hz": "Int", "control_hz": "Int", "action_scale_deg": "Float", "success_tolerance_m": "Float", "seed": "Int"},
      "output_types": {"environment": "Dict", "joint_names": "List", "observation_dim": "Int", "action_dim": "Int", "report": "Text"},
      "input_defaults": {"asset_path": "package://blacknode-newton/assets/so101_robot.usd", "environment_count": 1024, "episode_steps": 128, "simulation_hz": 120, "control_hz": 30, "action_scale_deg": 3.0, "success_tolerance_m": 0.025, "seed": 42},
      "promoted_inputs": ["environment_count", "episode_steps"], "promoted_outputs": ["environment", "report"]
    },
    "training": {
      "id": "training", "type": "PPOTraining", "pos": [490, 130],
      "params": {"action": "run", "environment": {}, "run_id": "so101-cloud-demo", "output_dir": "", "device": "auto", "updates": 50, "rollout_steps": 32, "learning_rate": 0.0003, "hidden_dim": 128, "epochs": 4, "minibatch_size": 4096, "gamma": 0.99, "gae_lambda": 0.95, "clip_ratio": 0.2, "entropy_coefficient": 0.01, "value_coefficient": 0.5, "max_gradient_norm": 0.5, "checkpoint_every": 10, "seed": 42, "resume": true, "viewer_enabled": false, "viewer_provider": "viser", "viewer_port": 8091, "viewer_fps": 15, "viewer_environment_index": 0, "replay_episodes": 3, "overwrite": false},
      "inputs": ["trigger", "action", "environment", "run_id", "output_dir", "device", "updates", "rollout_steps", "learning_rate", "hidden_dim", "epochs", "minibatch_size", "gamma", "gae_lambda", "clip_ratio", "entropy_coefficient", "value_coefficient", "max_gradient_norm", "checkpoint_every", "seed", "resume", "viewer_enabled", "viewer_provider", "viewer_port", "viewer_fps", "viewer_environment_index", "replay_episodes", "overwrite"],
      "outputs": ["ok", "running", "phase", "update", "status", "dashboard", "viewer", "viewer_url", "viewer_running", "mode", "replay_episode", "replay_episodes", "checkpoint", "report"],
      "input_types": {"trigger": "Any", "action": "Text", "environment": "Dict", "run_id": "Text", "output_dir": "Text", "device": "Text", "updates": "Int", "rollout_steps": "Int", "learning_rate": "Float", "hidden_dim": "Int", "epochs": "Int", "minibatch_size": "Int", "gamma": "Float", "gae_lambda": "Float", "clip_ratio": "Float", "entropy_coefficient": "Float", "value_coefficient": "Float", "max_gradient_norm": "Float", "checkpoint_every": "Int", "seed": "Int", "resume": "Bool", "viewer_enabled": "Bool", "viewer_provider": "Text", "viewer_port": "Int", "viewer_fps": "Int", "viewer_environment_index": "Int", "replay_episodes": "Int", "overwrite": "Bool"},
      "output_types": {"ok": "Bool", "running": "Bool", "phase": "Text", "update": "Int", "status": "Dict", "dashboard": "Image", "viewer": "Dict", "viewer_url": "Text", "viewer_running": "Bool", "mode": "Text", "replay_episode": "Int", "replay_episodes": "Int", "checkpoint": "Text", "report": "Text"},
      "input_defaults": {"action": "run", "environment": {}, "run_id": "so101-cloud-demo", "output_dir": "", "device": "auto", "updates": 50, "rollout_steps": 32, "learning_rate": 0.0003, "hidden_dim": 128, "epochs": 4, "minibatch_size": 4096, "gamma": 0.99, "gae_lambda": 0.95, "clip_ratio": 0.2, "entropy_coefficient": 0.01, "value_coefficient": 0.5, "max_gradient_norm": 0.5, "checkpoint_every": 10, "seed": 42, "resume": true, "viewer_enabled": false, "viewer_provider": "viser", "viewer_port": 8091, "viewer_fps": 15, "viewer_environment_index": 0, "replay_episodes": 3, "overwrite": false},
      "input_choices": {"action": ["start", "run", "replay", "status", "check", "stop"], "device": ["auto", "cuda", "cpu"], "viewer_provider": ["viser", "ovrtx"]},
      "promoted_inputs": ["environment", "updates", "rollout_steps", "checkpoint_every"], "promoted_outputs": ["checkpoint", "report"]
    },
    "checkpoint": {
      "id": "checkpoint", "type": "PPOCheckpointInspect", "pos": [890, 20], "params": {"checkpoint_path": ""},
      "inputs": ["trigger", "checkpoint_path"], "outputs": ["ok", "checkpoint", "update", "report"],
      "input_types": {"trigger": "Any", "checkpoint_path": "Text"}, "output_types": {"ok": "Bool", "checkpoint": "Dict", "update": "Int", "report": "Text"}, "input_defaults": {"checkpoint_path": ""}
    },
    "evaluate": {
      "id": "evaluate", "type": "PPOPolicyEvaluate", "pos": [890, 240], "params": {"action": "evaluate", "checkpoint_path": "", "artifact": {}, "device": "auto", "environment_count": 128},
      "inputs": ["trigger", "action", "checkpoint_path", "artifact", "device", "environment_count"], "outputs": ["ok", "evaluated", "metrics", "success_rate", "report"],
      "input_types": {"trigger": "Any", "action": "Text", "checkpoint_path": "Text", "artifact": "Dict", "device": "Text", "environment_count": "Int"}, "output_types": {"ok": "Bool", "evaluated": "Bool", "metrics": "Dict", "success_rate": "Float", "report": "Text"},
      "input_defaults": {"action": "evaluate", "checkpoint_path": "", "artifact": {}, "device": "auto", "environment_count": 128}, "input_choices": {"action": ["evaluate", "check"], "device": ["auto", "cuda", "cpu"]}
    },
    "export": {
      "id": "export", "type": "PPOPolicyExport", "pos": [1270, 160], "params": {"action": "export", "checkpoint_path": "", "output_dir": "", "model_format": "torchscript", "overwrite": true},
      "inputs": ["trigger", "action", "checkpoint_path", "output_dir", "model_format", "overwrite"], "outputs": ["ok", "exported", "artifact", "artifact_path", "report"],
      "input_types": {"trigger": "Any", "action": "Text", "checkpoint_path": "Text", "output_dir": "Text", "model_format": "Text", "overwrite": "Bool"}, "output_types": {"ok": "Bool", "exported": "Bool", "artifact": "Dict", "artifact_path": "Text", "report": "Text"},
      "input_defaults": {"action": "export", "checkpoint_path": "", "output_dir": "", "model_format": "torchscript", "overwrite": true}, "input_choices": {"action": ["export", "check"], "model_format": ["torchscript", "state_dict"]}
    },
    "qualify": {
      "id": "qualify", "type": "PPOPolicyQualify", "pos": [1610, 220],
      "params": {"action": "qualify", "artifact": {}, "evaluation": {}, "evaluations": [], "minimum_success_rate": 0.8, "minimum_completed_episodes": 64, "maximum_mean_distance_m": 0.05, "minimum_scenarios": 1},
      "inputs": ["trigger", "action", "artifact", "evaluation", "evaluations", "minimum_success_rate", "minimum_completed_episodes", "maximum_mean_distance_m", "minimum_scenarios"],
      "outputs": ["ok", "passed", "qualification", "qualification_path", "report"],
      "input_types": {"trigger": "Any", "action": "Text", "artifact": "Dict", "evaluation": "Dict", "evaluations": "List", "minimum_success_rate": "Float", "minimum_completed_episodes": "Int", "maximum_mean_distance_m": "Float", "minimum_scenarios": "Int"},
      "output_types": {"ok": "Bool", "passed": "Bool", "qualification": "Dict", "qualification_path": "Text", "report": "Text"},
      "input_defaults": {"action": "qualify", "artifact": {}, "evaluation": {}, "evaluations": [], "minimum_success_rate": 0.8, "minimum_completed_episodes": 64, "maximum_mean_distance_m": 0.05, "minimum_scenarios": 1},
      "input_choices": {"action": ["qualify", "check"]}
    },
    "out": {
      "id": "out", "type": "Output", "pos": [1980, 220], "params": {}, "inputs": ["value"], "outputs": [], "input_types": {"value": "Any"}, "output_types": {}, "input_defaults": {}
    }
  },
  "edges": [
    {"from": "task", "from_port": "environment", "to": "training", "to_port": "environment"},
    {"from": "training", "from_port": "checkpoint", "to": "checkpoint", "to_port": "checkpoint_path"},
    {"from": "training", "from_port": "checkpoint", "to": "evaluate", "to_port": "checkpoint_path"},
    {"from": "checkpoint", "from_port": "report", "to": "evaluate", "to_port": "trigger"},
    {"from": "training", "from_port": "checkpoint", "to": "export", "to_port": "checkpoint_path"},
    {"from": "evaluate", "from_port": "metrics", "to": "export", "to_port": "trigger"},
    {"from": "export", "from_port": "artifact", "to": "qualify", "to_port": "artifact"},
    {"from": "evaluate", "from_port": "metrics", "to": "qualify", "to_port": "evaluation"},
    {"from": "qualify", "from_port": "qualification", "to": "out", "to_port": "value"}
  ]
}
